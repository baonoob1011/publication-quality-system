{
  "info": {
    "_postman_id": "aa15ac82-d0ef-45bf-ae10-7e03cc97d999",
    "name": "Publication Quality System BE API",
    "description": "Postman Collection hoàn chỉnh cho Publication Quality System. \n\n### Hướng dẫn sử dụng:\n1. Chọn environment `Publication Quality System - Local`.\n2. Chạy request `Auth > POST Login` hoặc `Auth > POST Register` để tự động lấy token và lưu vào environment variable `access_token`.\n3. Các request khác đều kế thừa Bearer token này tự động.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "POST Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"researcher@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"fullName\": \"Dr. John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản researcher mới. Không yêu cầu auth."
          },
          "response": []
        },
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.accessToken) {",
                  "        pm.environment.set(\"access_token\", jsonData.data.accessToken);",
                  "        console.log(\"Saved access_token:\", jsonData.data.accessToken);",
                  "    }",
                  "    if (jsonData.data.refreshToken) {",
                  "        pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "        console.log(\"Saved refresh_token:\", jsonData.data.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"researcher@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập và tự động lưu access_token và refresh_token vào environment variables."
          },
          "response": []
        },
        {
          "name": "POST Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"access_token\", jsonData.data.accessToken);",
                  "    console.log(\"Refreshed access_token:\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Lấy access token mới bằng refresh token cũ."
          },
          "response": []
        },
        {
          "name": "POST Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"access_token\", \"\");",
                  "pm.environment.set(\"refresh_token\", \"\");",
                  "console.log(\"Tokens cleared from environment\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"{{access_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Đăng xuất tài khoản và xóa token khỏi environment."
          },
          "response": []
        },
